rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Allow authenticated users full access to their own user data and all subcollections
    match /users/{uid} {
      // Allow reading and writing the user document itself
      allow read, write: if request.auth != null && request.auth.uid == uid;

      // Allow reading and writing all chats for this user
      match /chats/{chatId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;

        // Allow reading and writing all messages in each chat
        match /messages/{messageId} {
          allow read, write: if request.auth != null && request.auth.uid == uid;
        }
      }

      // Allow any other subcollections
      match /{document=**} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }

    // Deny everything else by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

